#!/bin/bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

REPO_DIR="$HOME/k8s-home-server"
OUTPUT="$REPO_DIR/cluster-context.txt"
LOG_FILE="$HOME/.cache/cluster-context-rebuild.log"
LOCK_FILE="$REPO_DIR/.git/cluster-context.lock"

# --- 1. Conditional trigger: only run if K8s-related paths changed ---
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^(k8s|manifests|deploy|helm|flux)/'; then
  exit 0
fi

# --- 2. Verify repo2txt is available ---
if ! command -v repo2txt >/dev/null 2>&1; then
  echo "❌ repo2txt not found — cluster-context.txt NOT updated" >&2
  exit 0
fi

# --- 3. Prevent concurrent runs ---
if [ -e "$LOCK_FILE" ]; then
  echo "⚠️  Cluster context regeneration already in progress — skipping." >&2
  exit 0
fi
touch "$LOCK_FILE"

# --- 4. Run detached ---
mkdir -p "$(dirname "$LOG_FILE")"
nohup bash -c '
  trap "rm -f \"$1\"" EXIT
  repo2txt -r "$0" -o "$2" \
    --exclude-dir flux-system .git .github .githooks .vscode dashboards \
    --ignore-types .sops .lock \
    >> "$3" 2>&1
  echo "✅ $(date): cluster-context.txt updated" >> "$3"
' "$REPO_DIR" "$LOCK_FILE" "$OUTPUT" "$LOG_FILE" > /dev/null 2>&1 &
disown 2>/dev/null || true

exit 0