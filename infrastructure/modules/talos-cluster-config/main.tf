# infrastructure/modules/talos-cluster-config/main.tf

terraform {
  required_providers {
    talos = {
      source  = "siderolabs/talos"
      version = "~> 0.12.0"
    }
  }
}

locals {
  control_plane_ips = values(var.control_plane_nodes)[*].ip
  cluster_endpoint  = var.cluster_vip != null ? "https://${var.cluster_vip}:6443" : "https://${local.control_plane_ips[0]}:6443"

  vip_patch = var.cluster_vip != null ? [yamlencode({
    machine = {
      network = {
        interfaces = [{
          deviceSelector = { driver = "virtio_net" }
          vip = {
            ip = var.cluster_vip
          }
        }]
      }
    }
  })] : []
}

resource "talos_machine_secrets" "this" {
  talos_version = var.talos_version

  lifecycle {
    ignore_changes = [talos_version]
  }
}

data "talos_machine_configuration" "controlplane" {
  cluster_name     = var.cluster_name
  machine_type     = "controlplane"
  cluster_endpoint = local.cluster_endpoint
  machine_secrets  = talos_machine_secrets.this.machine_secrets
  talos_version    = var.talos_version

  # ✅ Removed the .machine.install patch to avoid conflict with
  # the UnattendedInstallConfig document generated by Talos 1.14+.
  config_patches = local.vip_patch
}

resource "talos_machine_configuration_apply" "controlplane" {
  for_each = var.control_plane_nodes

  client_configuration        = talos_machine_secrets.this.client_configuration
  machine_configuration_input = data.talos_machine_configuration.controlplane.machine_configuration
  node                        = each.value.ip

  # ✅ Talos 1.14+ no longer supports automatic reboot detection.
  # Use 'staged' to prevent automatic reboots, or 'auto' to allow them.
  apply_mode = "staged"
}

resource "talos_machine_bootstrap" "this" {
  depends_on = [talos_machine_configuration_apply.controlplane]

  client_configuration = talos_machine_secrets.this.client_configuration
  node                 = local.control_plane_ips[0]
}

data "talos_client_configuration" "this" {
  depends_on = [talos_machine_bootstrap.this]

  cluster_name         = var.cluster_name
  client_configuration = talos_machine_secrets.this.client_configuration
  endpoints            = local.control_plane_ips
  nodes                = local.control_plane_ips
}

resource "talos_cluster_kubeconfig" "this" {
  depends_on = [talos_machine_bootstrap.this]

  client_configuration = talos_machine_secrets.this.client_configuration
  node                 = local.control_plane_ips[0]
}