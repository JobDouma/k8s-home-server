# .envrc — direnv loader for the pve1 stack.
# Loads secrets from .env.local if present. Safe to commit.

# direnv's built-in dotenv directive (handles `export FOO=bar` and `FOO=bar`).
# to Reload: direnv reload
if [ -f .env.local ]; then
  dotenv .env.local
fi

# Non-secret defaults, safe to commit.
export TF_VAR_proxmox_node="${TF_VAR_proxmox_node:-pve1}"