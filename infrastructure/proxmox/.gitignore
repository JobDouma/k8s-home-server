# ─────────────────────────────────────────────────────────────────
# Terraform / OpenTofu
# ─────────────────────────────────────────────────────────────────
# Provider cache: huge, absolute paths, machine-specific.
**/.terraform/*

# Local state — the source of truth per host. Not in git.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
errored.tfstate

# Plan output — may embed resource attributes in plaintext (secrets).
*.tfplan
*.tfplan.json

# Local-only overrides — never commit.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config — can carry credentials.
.terraformrc
terraform.rc

# ─────────────────────────────────────────────────────────────────
# Lock file — COMMIT THIS
# ─────────────────────────────────────────────────────────────────
!**/.terraform.lock.hcl

# ─────────────────────────────────────────────────────────────────
# Secrets — never commit
# ─────────────────────────────────────────────────────────────────
.env
.env.local
.env.*
*.tfvars
*.tfvars.json

# But allow templates so the shape of secrets is documented.
!*.tfvars.example
!*.tfvars.json.example
!.env.example

# Key material
*.pem
*.key
*.p12
*.pfx
*.crt

# ─────────────────────────────────────────────────────────────────
# direnv
# ─────────────────────────────────────────────────────────────────
.direnv/

# ─────────────────────────────────────────────────────────────────
# Editor / OS noise
# ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
# .vscode/
# .idea/

# ─────────────────────────────────────────────────────────────────
# Logs / local backups / transient junk
# ─────────────────────────────────────────────────────────────────
*.log
*.bak
*.orig
*.rej

# ─────────────────────────────────────────────────────────────────
# Local ISO cache (no longer used, but belt-and-braces)
# ─────────────────────────────────────────────────────────────────
.cache/
**/.cache/

.iso-cache/
terraform.tfstate*
talosconfig
kubeconfig
terraform.tfvars

# .gitignore
*.agekey
age.agekey